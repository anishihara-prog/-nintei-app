# Gemini API設定（CLI・ウェブUI共通）
# 注意: 「学習に利用しない」保証を受けるには、このキーが紐づくGoogle Cloud
# プロジェクトで課金（有料枠）が有効になっている必要があります。
# 無料枠やnonprofitプログラムの利用枠だけでは保証されません。
# Google Cloud Console の「お支払い」画面で必ず確認してください。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ポート
PORT=8787

# 共有サーバーで複数人と使う場合のログイン認証（社内LAN限定でも設定を推奨）
# 未設定のままだと認証なしで起動する（ローカル1人利用向け）
APP_USERNAME=nintei
APP_PASSWORD=

# CLI設定
DATA_DIR=.nintei
DEBUG=false
